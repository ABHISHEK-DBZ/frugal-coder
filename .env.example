# Environment Configuration for Frugal Coder
# Copy this file to .env and configure your keys

PROJECT_NAME="Frugal Coder"
SECRET_KEY="generate-a-secure-random-jwt-secret-for-production"
DATABASE_URL="sqlite:///./frugal_coder.db"

# Central AI Gateway (Bifrost)
BIFROST_URL="http://localhost:8080"
BIFROST_API_KEY="your-bifrost-virtual-key-here"

# Primary Cloud Provider: Groq (Default for non-confidential tasks)
GROQ_API_KEY="your-groq-api-key-here"
GROQ_MODEL="openai/gpt-oss-120b"
GROQ_FAST_MODEL="openai/gpt-oss-20b"

# Secondary Cloud Failover Provider (e.g. OpenAI)
SECONDARY_CLOUD_PROVIDER="openai"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
ANTHROPIC_API_KEY=""

# Local Inference Runtime (Exclusively for confidential repositories)
# Pluggable: Ollama, vLLM, LocalAI, llama.cpp
LOCAL_INFERENCE_URL="http://localhost:11434"
LOCAL_INFERENCE_RUNTIME="ollama"
LOCAL_MODEL="qwen2.5-coder-3b-instruct-q4_k_m"

# Default User Budgets ($ USD)
DEFAULT_USER_BUDGET=10.00
DEFAULT_SESSION_BUDGET=2.00

# Tavily Search API (Research Tool)
TAVILY_API_KEY="your-tavily-api-key-here"
TAVILY_BASE_URL="https://api.tavily.com"
